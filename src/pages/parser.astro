---
import { Icon } from 'astro-icon/components'
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="账号解析器" showSidebar={false} showBanner={false} isIndexed={false}>
  <section class="parser-shell">
    <header class="glass-panel parser-hero">
      <span class="hero-icon"><Icon name="lucide:scan-text" class="h-7 w-7" /></span>
      <div>
        <p class="eyebrow">ACCOUNT PARSER</p>
        <h1>账号解析器</h1>
        <p>自动删除两个代码字段和提示，仅保留账号所需信息。</p>
      </div>
    </header>

    <div class="parser-grid">
      <section class="glass-panel parser-card">
        <div class="section-heading">
          <div>
            <span id="status" class="status">等待输入</span>
            <h2>粘贴账号内容</h2>
          </div>
          <Icon name="lucide:braces" class="h-6 w-6 text-primary" />
        </div>

        <textarea id="parser-input" rows="8" aria-label="待解析账号内容" placeholder="用户名----密码----邮箱----邮箱密码----代码----代码----2FA----提示"></textarea>

        <p class="format-hint">
          固定 8 段格式，使用 <code>----</code> 分隔。支持 <kbd>⌘/Ctrl</kbd> + <kbd>Enter</kbd> 快速解析。
        </p>

        <div class="actions">
          <button id="parse-button" class="primary-button" type="button"><Icon name="lucide:sparkles" class="h-4 w-4" />解析</button>
          <button id="clear-button" class="secondary-button" type="button"><Icon name="lucide:trash-2" class="h-4 w-4" />清空</button>
        </div>
      </section>

      <section class="glass-panel parser-card result-card">
        <div class="section-heading">
          <div><span class="status">解析结果</span><h2>可直接复制使用</h2></div>
          <Icon name="lucide:file-check-2" class="h-6 w-6 text-primary" />
        </div>
        <pre id="parser-output" aria-live="polite">粘贴内容后点击“解析”</pre>
        <button id="copy-button" class="primary-button copy-button" type="button" hidden><Icon name="lucide:copy" class="h-4 w-4" /><span>复制结果</span></button>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { parseAccount } from '@/lib/account-parser.js'

  const initParser = () => {
    const input = document.querySelector<HTMLTextAreaElement>('#parser-input')
    const output = document.querySelector<HTMLElement>('#parser-output')
    const status = document.querySelector<HTMLElement>('#status')
    const copyButton = document.querySelector<HTMLButtonElement>('#copy-button')
    const parseButton = document.querySelector<HTMLButtonElement>('#parse-button')
    const clearButton = document.querySelector<HTMLButtonElement>('#clear-button')
    if (!input || !output || !status || !copyButton || !parseButton || !clearButton || input.dataset.ready) return
    input.dataset.ready = 'true'

    let result = ''
    const parse = () => {
      try {
        result = parseAccount(input.value)
        output.textContent = result
        output.classList.remove('error')
        status.textContent = '解析成功'
        copyButton.hidden = false
      } catch (error) {
        result = ''
        output.textContent = `解析错误：${error instanceof Error ? error.message : '未知错误'}`
        output.classList.add('error')
        status.textContent = '格式不正确'
        copyButton.hidden = true
      }
    }

    parseButton.addEventListener('click', parse)
    clearButton.addEventListener('click', () => {
      input.value = ''
      result = ''
      output.textContent = '已清空，请粘贴内容'
      output.classList.remove('error')
      status.textContent = '等待输入'
      copyButton.hidden = true
      input.focus()
    })
    copyButton.addEventListener('click', async () => {
      await navigator.clipboard.writeText(result)
      const label = copyButton.querySelector('span')!
      label.textContent = '已复制'
      setTimeout(() => { label.textContent = '复制结果' }, 1200)
    })
    input.addEventListener('keydown', event => {
      if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') parse()
    })
  }

  initParser()
  document.addEventListener('astro:page-load', initParser)
</script>

<style>
  .parser-shell { width: 100%; display: grid; gap: 1rem; }
  .glass-panel { border: 1px solid color-mix(in srgb, white 70%, transparent); background: color-mix(in srgb, oklch(var(--b1)) 68%, transparent); backdrop-filter: blur(22px) saturate(1.2); -webkit-backdrop-filter: blur(22px) saturate(1.2); box-shadow: inset 0 1px 0 rgb(255 255 255 / .65), 0 18px 45px rgb(51 30 45 / .08); }
  .parser-hero { display: flex; align-items: center; gap: 1.2rem; padding: clamp(1.4rem, 4vw, 2.4rem); border-radius: 2rem; }
  .hero-icon { width: 4rem; height: 4rem; flex: none; display: grid; place-items: center; border-radius: 1.3rem; color: oklch(var(--p)); background: oklch(var(--p) / .12); }
  .eyebrow, .status { display: block; margin: 0; color: oklch(var(--bc) / .55); font-size: .7rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: .15rem 0 .4rem; font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800; line-height: 1; letter-spacing: -.04em; }
  .parser-hero p:last-child { margin: 0; color: oklch(var(--bc) / .65); }
  .parser-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .parser-card { min-width: 0; padding: clamp(1.25rem, 3vw, 2rem); border-radius: 1.75rem; }
  .section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
  h2 { margin: .2rem 0 0; font-size: 1.35rem; font-weight: 750; }
  textarea, pre { width: 100%; border: 1px solid oklch(var(--bc) / .1); border-radius: 1.25rem; color: oklch(var(--bc)); background: oklch(var(--b1) / .58); font: .88rem/1.65 ui-monospace, SFMono-Regular, Menlo, monospace; }
  textarea { min-height: 13rem; padding: 1rem; resize: vertical; transition: border-color .15s, box-shadow .15s; }
  textarea:focus { outline: 0; border-color: oklch(var(--p) / .55); box-shadow: 0 0 0 4px oklch(var(--p) / .1); }
  pre { min-height: 13rem; margin: 0; padding: 1rem; white-space: pre-wrap; word-break: break-word; }
  pre.error { color: oklch(var(--er)); border-color: oklch(var(--er) / .3); background: oklch(var(--er) / .08); }
  .format-hint { margin: .85rem 0 0; color: oklch(var(--bc) / .55); font-size: .8rem; }
  code, kbd { padding: .12rem .38rem; border-radius: .45rem; background: oklch(var(--bc) / .07); font: inherit; }
  .actions { display: flex; gap: .7rem; margin-top: 1.1rem; }
  button { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; border: 0; border-radius: 999px; padding: .7rem 1.1rem; font: inherit; font-size: .85rem; font-weight: 700; cursor: pointer; }
  button[hidden] { display: none; }
  .primary-button { color: oklch(var(--pc)); background: oklch(var(--p)); box-shadow: 0 8px 20px oklch(var(--p) / .2); }
  .secondary-button { color: oklch(var(--bc)); background: oklch(var(--bc) / .08); }
  button:active { transform: scale(.97); }
  .copy-button { margin-top: 1rem; }
  @media (max-width: 760px) { .parser-grid { grid-template-columns: 1fr; } .parser-hero { align-items: flex-start; flex-direction: column; } .hero-icon { width: 3.25rem; height: 3.25rem; } }
</style>
