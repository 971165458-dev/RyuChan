---
import { Icon } from 'astro-icon/components'
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f5edf2" />
  <title>今日文章密码</title>
</head>
<body>
  <div class="page-glow glow-one"></div>
  <div class="page-glow glow-two"></div>
  <main class="password-shell">
    <header class="password-hero">
      <div class="password-icon"><Icon name="lucide:key-round" class="h-7 w-7" /></div>
      <div>
        <p class="eyebrow">DAILY ACCESS</p>
        <h1>今日文章密码</h1>
        <p>密码每天北京时间 00:00 自动更新，昨日密码将立即失效。</p>
      </div>
    </header>

    <div class="status-bar">
      <div><span>下次更新</span><strong id="password-countdown">--:--:--</strong></div>
      <div><span>最近更新</span><strong id="password-updated">读取中…</strong></div>
    </div>

    <div id="password-error" class="error-message" hidden>密码读取失败，请稍后刷新页面。</div>
    <div id="password-grid" class="password-grid" aria-live="polite"></div>

    <template id="password-card-template">
      <article class="password-card">
        <div class="card-heading">
          <div class="group-icon"><Icon name="lucide:lock-keyhole" class="h-5 w-5" /></div>
          <div><span class="group-label">密码组</span><h2></h2></div>
        </div>
        <div class="password-row">
          <code></code>
          <button type="button" class="copy-button" aria-label="复制密码">
            <Icon name="lucide:copy" class="h-4 w-4" />
            <span>复制</span>
          </button>
        </div>
      </article>
    </template>
  </main>
</body>
</html>

<script>
  const renderPasswords = async () => {
    const grid = document.querySelector<HTMLDivElement>('#password-grid')
    const template = document.querySelector<HTMLTemplateElement>('#password-card-template')
    const error = document.querySelector<HTMLElement>('#password-error')
    const updated = document.querySelector<HTMLElement>('#password-updated')
    if (!grid || !template || !error || !updated) return

    try {
      const response = await fetch('/daily-password.json', { cache: 'no-store' })
      if (!response.ok) throw new Error('password request failed')
      const data = await response.json()
      const entries = [['默认密码', String(data.password)], ...Object.entries(data.passwords || {})] as [string, string][]
      grid.replaceChildren()

      for (const [name, password] of entries) {
        const card = template.content.firstElementChild!.cloneNode(true) as HTMLElement
        card.querySelector('h2')!.textContent = name
        card.querySelector('code')!.textContent = password
        if (name === '默认密码') card.classList.add('is-default')
        card.querySelector('button')!.addEventListener('click', async event => {
          await navigator.clipboard.writeText(password)
          const label = (event.currentTarget as HTMLButtonElement).querySelector('span')!
          label.textContent = '已复制'
          setTimeout(() => { label.textContent = '复制' }, 1200)
        })
        grid.append(card)
      }

      updated.textContent = new Intl.DateTimeFormat('zh-CN', {
        timeZone: 'Asia/Shanghai', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false,
      }).format(new Date(data.updatedAt))
      error.hidden = true
    } catch {
      error.hidden = false
    }
  }

  const updateCountdown = () => {
    const target = document.querySelector<HTMLElement>('#password-countdown')
    if (!target) return
    const now = new Date()
    const beijing = new Date(now.getTime() + 8 * 60 * 60 * 1000)
    const next = Date.UTC(beijing.getUTCFullYear(), beijing.getUTCMonth(), beijing.getUTCDate() + 1) - 8 * 60 * 60 * 1000
    const seconds = Math.max(0, Math.floor((next - now.getTime()) / 1000))
    const hh = String(Math.floor(seconds / 3600)).padStart(2, '0')
    const mm = String(Math.floor(seconds % 3600 / 60)).padStart(2, '0')
    const ss = String(seconds % 60).padStart(2, '0')
    target.textContent = `${hh}:${mm}:${ss}`
    if (seconds === 0) renderPasswords()
  }

  const initPasswordPage = () => {
    clearInterval((window as any).passwordPageTimer)
    renderPasswords()
    updateCountdown()
    ;(window as any).passwordPageTimer = setInterval(updateCountdown, 1000)
  }

  initPasswordPage()
  document.addEventListener('astro:page-load', initPasswordPage)
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-height: 100%; background: #f5edf2; }
  :global(body) { min-height: 100vh; margin: 0; overflow-x: hidden; color: #20191e; background: radial-gradient(circle at 50% -15%, #fff 0, #f8f0f5 38%, #eadfe6 100%); font-family: ui-rounded, "SF Pro Rounded", "PingFang SC", system-ui, sans-serif; }
  .page-glow { position: fixed; width: 32rem; height: 32rem; border-radius: 50%; filter: blur(90px); opacity: .32; pointer-events: none; }
  .glow-one { top: -16rem; left: -10rem; background: #ff4b9b; }
  .glow-two { right: -14rem; bottom: -18rem; background: #a67cff; }
  .password-shell { position: relative; z-index: 1; width: min(calc(100% - 2rem), 980px); margin: 0 auto; padding: clamp(2rem, 7vw, 5rem) 0; }
  .password-hero, .status-bar, .password-card { border: 1px solid rgb(255 255 255 / .72); background: rgb(255 255 255 / .46); backdrop-filter: blur(24px) saturate(1.25); -webkit-backdrop-filter: blur(24px) saturate(1.25); box-shadow: inset 0 1px 0 rgb(255 255 255 / .85), 0 18px 45px rgb(73 44 62 / .09); }
  .password-hero { display: flex; gap: 1.25rem; align-items: center; border-radius: 2rem; padding: clamp(1.5rem, 5vw, 3rem); }
  .password-icon, .group-icon { display: grid; place-items: center; flex: none; color: #ff1684; background: rgb(255 22 132 / .1); }
  .password-icon { width: 4rem; height: 4rem; border-radius: 1.3rem; }
  .group-icon { width: 2.75rem; height: 2.75rem; border-radius: .9rem; }
  .eyebrow, .group-label, .status-bar span { display: block; font-size: .7rem; font-weight: 600; letter-spacing: .16em; opacity: .55; }
  h1 { margin: .15rem 0 .45rem; font-size: clamp(2rem, 6vw, 3.75rem); font-weight: 800; line-height: 1; letter-spacing: -.04em; }
  .password-hero p:last-child { opacity: .62; }
  .status-bar { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 1rem 0; padding: 1rem 1.25rem; border-radius: 1.25rem; }
  .status-bar div:last-child { text-align: right; }
  .status-bar strong { display: block; margin-top: .2rem; font-size: .95rem; font-variant-numeric: tabular-nums; }
  .password-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; }
  .password-card { border-radius: 1.7rem; padding: 1.25rem; }
  .password-card.is-default { border-color: rgb(255 22 132 / .32); }
  .card-heading { display: flex; align-items: center; gap: .8rem; }
  .card-heading h2 { margin-top: .1rem; font-size: 1rem; font-weight: 700; }
  .password-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
  .password-row code { font-family: inherit; font-size: 2.5rem; font-weight: 700; letter-spacing: .18em; font-variant-numeric: tabular-nums; }
  .copy-button { display: flex; align-items: center; gap: .35rem; border: 0; border-radius: 999px; padding: .55rem .8rem; color: inherit; background: rgb(32 25 30 / .07); font: inherit; font-size: .75rem; cursor: pointer; transition: transform .15s ease, background .15s ease; }
  .copy-button:hover { background: rgb(255 22 132 / .12); }
  .copy-button:active { transform: scale(.96); }
  .error-message { border-radius: 1rem; padding: 1rem; background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; text-align: center; }
  @media (max-width: 700px) { .password-shell { padding-top: 1rem; } .password-hero { align-items: flex-start; flex-direction: column; } .password-icon { width: 3.25rem; height: 3.25rem; } h1 { font-size: clamp(2rem, 11vw, 3rem); } .status-bar { grid-template-columns: 1fr; } .status-bar div:last-child { text-align: left; } }
</style>
