---
import { Icon } from "astro-icon/components";
import NavEditPage from "@/components/write/NavEditPage";
import FriendsEditPage from "@/components/write/FriendsEditPage";
import AlbumGrid from "@/components/admin/AlbumGrid";
import AlbumAdmin from "@/components/admin/AlbumAdmin";
import AlbumToolbar from "@/components/admin/AlbumToolbar";
import Card from "@/components/temple/Card.astro";
import { loadNavigation } from "@/lib/load-navigation";
import { loadFriends } from "@/lib/load-friends";
import {
  USER_AVATAR,
  USER_DESCRIPTION,
  USER_NAME,
  USER_QR_ALIPAY,
  USER_QR_WECHAT,
  USER_SIDEBAR_SOCIAL_ICONS,
} from "@/config";

const navData = loadNavigation();
const friends = loadFriends();
---

<div class="flex flex-col gap-12 mt-12">
  <section id="navigation" class="home-section scroll-mt-28" aria-labelledby="navigation-title">
    <Card class="p-5 md:p-7">
      <div class="mb-5">
        <h2 id="navigation-title" class="text-3xl font-bold flex items-center gap-3">
          <Icon name="material-symbols:explore-outline" class="w-8 h-8 text-primary" />
          网站导航
        </h2>
        <p class="mt-2 text-base-content/65">常用网站与工具入口。</p>
      </div>
      <NavEditPage client:only="react" initialNavData={navData} />
    </Card>
  </section>

  <section id="album" class="home-section scroll-mt-28" aria-labelledby="album-title">
    <Card class="p-5 md:p-7">
      <div class="flex items-center justify-between gap-4 mb-5">
        <div>
          <h2 id="album-title" class="text-3xl font-bold flex items-center gap-3">
            <Icon name="lucide:camera" class="w-8 h-8 text-primary" />
            相册
          </h2>
          <p class="mt-2 text-base-content/65">记录生活中的美好瞬间。</p>
        </div>
        <AlbumToolbar client:only="react" />
      </div>
      <AlbumGrid client:only="react" />
    </Card>
    <AlbumAdmin client:only="react" />
  </section>

  <section id="services" class="home-section scroll-mt-28" aria-labelledby="services-title">
    <div class="mb-5">
      <h2 id="services-title" class="text-3xl font-bold flex items-center gap-3">
        <Icon name="material-symbols:supervisor-account-outline-rounded" class="w-8 h-8 text-primary" />
        更多服务
      </h2>
      <p class="mt-2 text-base-content/65">朋友与推荐站点。</p>
    </div>
    <FriendsEditPage client:only="react" initialFriends={friends} />
  </section>

  <section id="contact" class="home-section scroll-mt-28" aria-labelledby="contact-title">
    <Card class="p-6 md:p-8">
      <h2 id="contact-title" class="text-3xl font-bold flex items-center gap-3 mb-7">
        <Icon name="material-symbols:contact-mail-outline" class="w-8 h-8 text-primary" />
        联系我
      </h2>

      <div class="flex flex-col lg:flex-row gap-8 items-center lg:items-start">
        <img
          src={USER_AVATAR}
          alt={`${USER_NAME} avatar`}
          class="w-32 h-32 rounded-3xl object-cover ring ring-primary ring-offset-4 ring-offset-base-100"
          loading="lazy"
        />

        <div class="flex-1 text-center lg:text-left">
          <h3 class="text-2xl font-bold">{USER_NAME}</h3>
          <p class="mt-2 text-base-content/70">{USER_DESCRIPTION}</p>
          <div class="mt-5 flex flex-wrap justify-center lg:justify-start gap-3">
            {USER_SIDEBAR_SOCIAL_ICONS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.ariaLabel}
                class="btn btn-outline btn-sm gap-2"
              >
                <Icon name={social.svg} class="w-4 h-4" />
                {social.title || social.ariaLabel}
              </a>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 shrink-0">
          <figure class="text-center">
            <img src={USER_QR_WECHAT} alt="微信二维码" class="w-28 h-28 rounded-xl object-cover" loading="lazy" />
            <figcaption class="mt-2 text-sm text-base-content/60">微信</figcaption>
          </figure>
          <figure class="text-center">
            <img src={USER_QR_ALIPAY} alt="支付宝二维码" class="w-28 h-28 rounded-xl object-cover" loading="lazy" />
            <figcaption class="mt-2 text-sm text-base-content/60">支付宝</figcaption>
          </figure>
        </div>
      </div>
    </Card>
  </section>
</div>
